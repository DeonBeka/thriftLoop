{
  "expo": {
    "name": "ThriftLoop",
    "slug": "ThriftLoop",
    "scheme": "thriftloop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F1EA"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thriftloop.marketplace",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F1EA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "ThriftLoop needs access to your photos so you can add pictures to your listings.",
          "cameraPermission": "ThriftLoop uses the camera to photograph items you sell and to take a verification selfie when you apply to become a seller.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ThriftLoop uses your location to fill in your delivery address when you order."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
