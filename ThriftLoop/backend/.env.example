# Copy to backend/.env and fill in. Never commit the real .env.

# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Comma separated emails that are admins (approve sellers, moderate). Admin can't be granted any other way.
ADMIN_EMAILS=you@gmail.com

# Rate limiting (requests per minute per user/IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=20

# false (default) = new accounts are active right away, no code is sent.
# true = users must enter a 6-digit code emailed to them (needs the SMTP settings below,
#        or EMAIL_DEV_MODE=true to print codes in the backend terminal).
REQUIRE_EMAIL_VERIFICATION=false

# Gmail SMTP — the app admin's Gmail account, NOT the users'.
# Create an App Password at https://myaccount.google.com/apppasswords (needs 2-Step Verification).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.app.account@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_NAME=ThriftLoop

# true = print verification codes to the server console instead of emailing them.
# Codes are also printed automatically if SMTP_USERNAME / SMTP_PASSWORD are empty.
EMAIL_DEV_MODE=false

# Comma separated. Leave empty to allow any email domain.
ALLOWED_EMAIL_DOMAINS=gmail.com

OTP_EXPIRE_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# AI shopping assistant (optional). Without a key the assistant uses its built-in parser.
# Get a key at https://platform.claude.com - keep it here, never in the app.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
# Free alternative when no Anthropic key is set: a Google AI Studio key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Read each listing's colour from its main photo (uses the AI above if set, otherwise built-in).
PHOTO_COLORS_ENABLED=true
RATE_LIMIT_ASSISTANT_PER_MINUTE=20
